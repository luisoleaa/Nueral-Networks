# compiled python, never useful in source control
__pycache__/
*.pyc

# generated checkpoints / demo data -- regenerate by rerunning the scripts.
# evolve_ckpt.npz and evolved_weights.npz are force-added exceptions (see
# the git add -f in the commit for this) since they're the GA's actual
# useful output, not just training exhaust.
*.npz

# training/run logs and metric csvs, all regenerated by rerunning things
*.log
*.csv

# generated plots
*.png
